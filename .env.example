# คัดลอกเป็น .env.local แล้วใส่ค่าจริงของ Supabase Project "onemart-event" (ห้าม commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>

# ใช้เฉพาะสคริปต์ seed/ฝั่งเซิร์ฟเวอร์ — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามใส่ใน Vercel ฝั่ง client
SUPABASE_SECRET_KEY=<sb_secret_...>
